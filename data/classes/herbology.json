        {"at_ms": 25000, "prompt": "fern_curl", "options": ["t_duster", "t_gloves", "t_shade", "t_compost"]}
      ] },
    {"at_secs": 340, "kind": "demonstrate", "duration_ms": 2000, "line": "A little faster. Keep your eyes on the leaves, not on your neighbour's shears."},
