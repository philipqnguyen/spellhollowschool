  "lesson": [
    {"at_secs": 2, "kind": "emote", "emote": "wave"},
    {"at_secs": 3, "kind": "say", "line": "Come in, come in. Gloves on, sleeves rolled up, and keep your fingers where you can count them."},
    {"at_secs": 45, "kind": "say", "line": "Every plant on this bench wants something. Your task is to notice what, and to give it before the plant helps itself."},
    {"at_secs": 90, "kind": "say", "line": "Watch the stems and the leaves. A plant always says what it needs, if you are quick enough to listen."},
    {"at_secs": 130, "kind": "say", "line": "Close the glasshouse door behind you, please. The draught upsets the ferns."},
    {"at_secs": 170, "kind": "say", "line": "The door is shut. Let's meet the bench."},
    {"at_secs": 185, "kind": "demonstrate", "duration_ms": 2000, "line": "The Gnashvine first: shears for a snapping vine, a stake for a sprawling one, water for a droop. And the Shriekroot: earmuffs on you before it wails, water for cracked soil, compost when it shivers."},
    {"at_secs": 200, "kind": "practice", "round": 1, "window_ms": 2000, "beats": [
        {"at_ms": 5000, "prompt": "vine_lunge", "options": ["t_compost", "t_shears", "t_stake"]},
        {"at_ms": 9000, "prompt": "root_wail", "options": ["t_earmuffs", "t_compost", "t_duster"]},
        {"at_ms": 13000, "prompt": "vine_sprawl", "options": ["t_duster", "t_earmuffs", "t_stake"]},
        {"at_ms": 17000, "prompt": "root_dry", "options": ["t_water", "t_shears", "t_duster"]},
        {"at_ms": 21000, "prompt": "vine_wilt", "options": ["t_stake", "t_duster", "t_water"]},
        {"at_ms": 25000, "prompt": "root_shiver", "options": ["t_duster", "t_shade", "t_compost"]}
      ] },
    {"at_secs": 240, "kind": "demonstrate", "duration_ms": 2000, "line": "The Needlebriar: gloves when it bristles, shears when it reaches for the path, shade when it scorches. The Shiverfern: a feather duster to tease it open, a stake when it leans, compost when it pales."},
    {"at_secs": 250, "kind": "practice", "round": 2, "window_ms": 2000, "beats": [
        {"at_ms": 5000, "prompt": "briar_bristle", "options": ["t_gloves", "t_shade", "t_compost"]},
        {"at_ms": 9000, "prompt": "fern_curl", "options": ["t_duster", "t_earmuffs", "t_compost"]},
        {"at_ms": 13000, "prompt": "briar_overgrown", "options": ["t_stake", "t_shears", "t_water"]},
        {"at_ms": 17000, "prompt": "fern_lean", "options": ["t_stake", "t_shears", "t_shade"]},
        {"at_ms": 21000, "prompt": "briar_scorch", "options": ["t_shade", "t_compost", "t_duster"]},
        {"at_ms": 25000, "prompt": "fern_pale", "options": ["t_duster", "t_earmuffs", "t_compost"]}
      ] },
    {"at_secs": 290, "kind": "demonstrate", "duration_ms": 2000, "line": "The whole bench at once now, and four tools to choose from. They will not wait their turn, so neither shall we."},
    {"at_secs": 300, "kind": "practice", "round": 3, "window_ms": 2000, "beats": [
        {"at_ms": 5000, "prompt": "root_wail", "options": ["t_stake", "t_gloves", "t_earmuffs", "t_shears"]},
        {"at_ms": 9000, "prompt": "fern_lean", "options": ["t_shears", "t_shade", "t_water", "t_stake"]},
        {"at_ms": 13000, "prompt": "vine_lunge", "options": ["t_shade", "t_earmuffs", "t_shears", "t_compost"]},
