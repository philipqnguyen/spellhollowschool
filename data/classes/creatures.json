    {"at_secs": 405, "kind": "results", "line": "Well done, the lot of you. They've shed a little fur and feather for you, and the better the whole class did, the more you've all learned."},
    {"at_secs": 410, "kind": "emote", "emote": "bow"},
    {"at_secs": 500, "kind": "say", "line": "Off you go. Wash your hands, and close the gate behind you."}
