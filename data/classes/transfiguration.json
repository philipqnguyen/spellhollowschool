  "lesson": [
    {"at_secs": 2, "kind": "emote", "emote": "wave"},
    {"at_secs": 3, "kind": "say", "line": "Good day. Take a desk, and keep your wand flat on it until I say otherwise."},
    {"at_secs": 45, "kind": "say", "line": "Every transfiguration is a chain of small, deliberate changes. Size, material, colour, shape."},
    {"at_secs": 90, "kind": "say", "line": "Look at what is in front of you, then at what it must become. Choose the one change that closes the gap."},
    {"at_secs": 130, "kind": "say", "line": "If you are still in the corridor, I suggest you hurry."},
    {"at_secs": 170, "kind": "say", "line": "The door is closing. Attention, please."},
    {"at_secs": 185, "kind": "demonstrate", "gesture": "circle", "duration_ms": 1600, "line": "Observe: one change at a time, cleanly made. Three choices each, to start."},
