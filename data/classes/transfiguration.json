        {"at_ms": 13000, "prompt": "quill_silver", "options": ["to_silver", "to_wood", "to_blue"]},
        {"at_ms": 17000, "prompt": "candle_glass", "options": ["to_silver", "to_glass", "flatten"]},
        {"at_ms": 21000, "prompt": "spoon_wood", "options": ["to_blue", "to_red", "to_wood"]},
        {"at_ms": 25000, "prompt": "button_red", "options": ["to_red", "to_green", "grow"]}
      ] },
    {"at_secs": 240, "kind": "demonstrate", "gesture": "circle", "duration_ms": 1600, "line": "Better. Now four choices. Do not let the colour distract you from the shape."},
    {"at_secs": 250, "kind": "practice", "round": 2, "window_ms": 1500, "beats": [
        {"at_ms": 5000, "prompt": "spoon_wood", "options": ["to_wood", "grow", "shrink", "to_red"]},
        {"at_ms": 8800, "prompt": "button_red", "options": ["to_silver", "to_red", "to_blue", "to_glass"]},
        {"at_ms": 12600, "prompt": "matchbox_blue", "options": ["to_green", "make_round", "to_blue", "to_glass"]},
        {"at_ms": 16400, "prompt": "pincushion_round", "options": ["grow", "make_round", "to_wood", "to_glass"]},
        {"at_ms": 20200, "prompt": "teacup_saucer", "options": ["to_green", "to_blue", "make_round", "flatten"]},
        {"at_ms": 24000, "prompt": "candle_tall", "options": ["flatten", "stretch", "make_round", "to_green"]},
        {"at_ms": 27800, "prompt": "teacup_giant", "options": ["flatten", "to_wood", "grow", "stretch"]},
        {"at_ms": 31600, "prompt": "key_tiny", "options": ["to_green", "shrink", "to_glass", "stretch"]}
      ] },
    {"at_secs": 290, "kind": "demonstrate", "gesture": "twirl_and_tap", "duration_ms": 1800, "line": "Now two changes in a row. Make the first, then the second. Order matters."},
    {"at_secs": 300, "kind": "practice", "round": 3, "window_ms": 1500, "beats": [
