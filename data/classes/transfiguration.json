        {"at_ms": 24000, "prompt": "button_big_green_2", "options": ["to_green", "to_blue", "to_glass", "shrink"]}
      ] },
    {"at_secs": 340, "kind": "demonstrate", "gesture": "circle", "duration_ms": 1600, "line": "And all of it together, a little quicker. Steady hands."},
    {"at_secs": 350, "kind": "practice", "round": 4, "window_ms": 1400, "beats": [
