# Copy to docker/.env and adjust. docker compose reads it for variable substitution.

# Required: password for the Postgres "shs" user.
POSTGRES_PASSWORD=change-me

# Base URL players reach this server at (used in emailed links), e.g.
# https://game.example.org.
SHS_PUBLIC_URL=http://localhost:8080

# Concurrent players in the castle world; beyond it logins queue.
SHS_PLAYER_CAP=1000

# Email, so players can confirm their accounts: an SMTP URL
# (smtps://user:pass@host:465 or smtp://user:pass@host:587?tls=required) and
# the sender. Empty: emails are only logged.
SHS_SMTP_URL=
SHS_MAIL_FROM=

# Behind a reverse proxy on this host (nginx, Caddy, Traefik ...), so rate
# limits key on each player's address instead of the proxy's. Set exactly one:
#   SHS_TRUST_PROXY=1            the proxy appends the client to X-Forwarded-For
#   SHS_CLIENT_IP_HEADER=<name>  the edge sets this header to the client address
#                                (cf-connecting-ip behind Cloudflare)
# Only when the server is reachable through that proxy alone (SHS_HTTP_HOST
# below stays 127.0.0.1); otherwise clients can choose their own address.
SHS_TRUST_PROXY=
SHS_CLIENT_IP_HEADER=

# Public URL of an asset bucket the client loads game assets from
# (docs/deploy.md, "Assets from a bucket"). Empty: this server serves them.
SHS_ASSETS_CDN_URL=

# Set to 1 only for development: enables /api/dev/* and returns verification links.
SHS_DEV=

# Log filter (tracing EnvFilter syntax), e.g. info or info,server=debug
RUST_LOG=info

# Host address and ports. The game port is published on loopback for a proxy
# on this host; 0.0.0.0 exposes it on every interface (only with no proxy).
SHS_HTTP_HOST=127.0.0.1
SHS_HTTP_PORT=8080
SHS_DB_PORT=5432
