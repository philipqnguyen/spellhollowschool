# One destination's settings for config/deploy.yml and .kamal/secrets-common.
# Copy this file to .kamal/deploy.<destination>.env (gitignored), e.g.
# .kamal/deploy.production.env, fill it in, and run kamal with -d <destination>.
# docs/deploy.md explains each step.

# ---- Required ---------------------------------------------------------------

# The server to deploy to: an IP address or hostname you can SSH into.
DEPLOY_HOST=203.0.113.10

# The domain players open. Its DNS A (and AAAA) record must point at
# DEPLOY_HOST before the first deploy, for the Let's Encrypt certificate.
DEPLOY_DOMAIN=game.example.org

# The Postgres password. Letters and digits only: it goes into a URL.
# Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Email, so players can confirm their accounts (sign-in needs it).
# Any SMTP provider works. smtps:// is TLS on port 465; smtp://...?tls=required
# is STARTTLS on 587. Percent-encode special characters in the user and password.
# Postmark, for example: smtp://<server token>:<server token>@smtp.postmarkapp.com:587?tls=required
SHS_SMTP_URL=smtps://USER:PASSWORD@smtp.example.org:465
SHS_MAIL_FROM=SpellHollow School <no-reply@example.org>

# ---- Optional (defaults shown) ------------------------------------------------

# SSH user and port. A user other than root must be in the docker group.
# DEPLOY_SSH_USER=root
# DEPLOY_SSH_PORT=22

# The server's CPU architecture: amd64 or arm64.
# DEPLOY_ARCH=amd64

# How players reach the server (docs/deploy.md, "Cloudflare Tunnel"):
#   direct              kamal-proxy on ports 80 and 443, Let's Encrypt certificate
#   cloudflare-tunnel   every request comes through a Cloudflare Tunnel; the
#                       server opens no web ports and Cloudflare does TLS.
#                       Needs CLOUDFLARE_TUNNEL_TOKEN.
# DEPLOY_EDGE=direct
# CLOUDFLARE_TUNNEL_TOKEN=

# With DEPLOY_EDGE=direct, false: no Let's Encrypt certificate, plain HTTP
# (behind a TLS-terminating load balancer that talks HTTP to the server).
# DEPLOY_SSL=true

# Where images go. The default runs a registry on your machine and the server
# pulls from it through the SSH connection: no account needed. For a hosted
# registry set the server, the username and KAMAL_REGISTRY_PASSWORD (a token),
# and the image name it expects, e.g. ghcr.io and <your user>/spellhollow.
# DEPLOY_REGISTRY=localhost:5555
# DEPLOY_REGISTRY_USERNAME=
# KAMAL_REGISTRY_PASSWORD=
# DEPLOY_IMAGE=spellhollow

# Build on another machine over SSH, e.g. ssh://root@203.0.113.10 to build on
# the server itself (the Dockerfile already cross-compiles, so rarely needed).
# DEPLOY_BUILDER_REMOTE=

# Players allowed in the castle at once; beyond it logins wait in a queue.
# SHS_PLAYER_CAP=1000

# Server log filter.
# RUST_LOG=info

# Error tracking and performance with Good Sorcery (docs/deploy.md, "Error
# tracking and performance"): the project's API key, from Settings > Setup &
# API keys at https://app.goodsorcery.com. Empty: nothing is reported.
# GOODSORCERY_API_KEY=
# 0: report errors only, without response times.
# GOODSORCERY_PERFORMANCE_MONITORING=1

# Deploy even when client/public/assets does not match this checkout (the
# client then draws greybox stand-ins for what is missing).
# DEPLOY_ALLOW_GREYBOX=0

# ---- Asset bucket (optional; docs/deploy.md, "Assets from a bucket") ---------

# Serve the game assets from an S3-compatible bucket behind a CDN (Cloudflare
# R2 on its own hostname) by content-addressed keys, cached forever. The
# pre-deploy hook uploads what the bucket lacks, the image leaves the assets
# out, and the server points the client at DEPLOY_ASSETS_PUBLIC_URL. Unset:
# the image carries the assets and the game server serves them.
# DEPLOY_ASSETS_BUCKET=spellhollow-assets
# The S3 API endpoint: R2 https://<account id>.r2.cloudflarestorage.com,
# AWS https://s3.<region>.amazonaws.com, MinIO http://host:9000.
# DEPLOY_ASSETS_S3_ENDPOINT=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
# The bucket's region: auto for R2.
# DEPLOY_ASSETS_S3_REGION=auto
# Where players load the assets (the bucket's custom domain). Required with a bucket.
# DEPLOY_ASSETS_PUBLIC_URL=https://assets.example.org
# The uploader's API token (R2: Object Read & Write on this bucket). Used on
# this machine only, never sent to the server; may come from your shell instead.
# DEPLOY_ASSETS_ACCESS_KEY_ID=
# DEPLOY_ASSETS_SECRET_ACCESS_KEY=
# 0: store new objects uncompressed (default 1: models and JSON gzip-encoded).
# DEPLOY_ASSETS_GZIP=1
# 0: skip loading one object through DEPLOY_ASSETS_PUBLIC_URL after uploading.
# DEPLOY_ASSETS_VERIFY=1
# After each deploy, delete the objects none of the last
# DEPLOY_ASSETS_PRUNE_KEEP versions uses (0: never delete anything).
# DEPLOY_ASSETS_PRUNE=1
# DEPLOY_ASSETS_PRUNE_KEEP=3
