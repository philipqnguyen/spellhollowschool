# Secrets for config/deploy.yml, shared by every destination, in dotenv syntax.
# Kamal reads this file when it needs a secret; nothing secret is written here.
# The values come from the destination's .kamal/deploy.<destination>.env
# (loaded by config/deploy.yml) or your shell. A .kamal/secrets.<destination>
# file, if you add one, overrides these for that destination; to use a
# password manager, see https://kamal-deploy.org/docs/commands/secrets/.

# The database's password, and the server's URL for it. spellhollow-db is the
# accessory's container name on the kamal network (service "spellhollow").
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=postgres://shs:$POSTGRES_PASSWORD@spellhollow-db:5432/shs

# The mail server (empty: emails are only logged and nobody can confirm an account).
SHS_SMTP_URL=$SHS_SMTP_URL

# Error tracking and performance (empty: nothing is reported; docs/deploy.md).
GOODSORCERY_API_KEY=$GOODSORCERY_API_KEY

# Only for a registry other than the local one (DEPLOY_REGISTRY).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Only with DEPLOY_EDGE=cloudflare-tunnel: the tunnel's token (Cloudflare
# dashboard, Networks > Tunnels > your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=$CLOUDFLARE_TUNNEL_TOKEN
